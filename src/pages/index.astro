				<div class="wrap cta-inner">
					<div>
						<h2>Usi già RadioPanel?</h2>
						<p>Accedi al pannello della tua radio o consulta la documentazione.</p>
					</div>
					<div class="actions">
						<a class="btn btn-primary btn-lg" href={PANEL_URL}>
							<i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Accedi al pannello
						</a>
						<a class="btn btn-lg" href={DOCS_URL}>
							<i class="bi bi-journal-text" aria-hidden="true"></i>Documentazione
						</a>
