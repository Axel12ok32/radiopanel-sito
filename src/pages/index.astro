---
// Sito vetrina di RadioPanel: presentazione, funzioni, compatibilità, licenza e contatti.
// Stile: gli stessi token del pannello (_css/style.css), vedi src/styles/sito.css.
// Indirizzi, contatti e sezioni in src/links.ts; scheletro della pagina in src/layouts/Base.astro.
import Base from '../layouts/Base.astro';
import CardHead from '../components/CardHead.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { DOCS, DOCS_HOST, DOCS_URL, INFO_MAIL, OWNER, PANEL_HOST, PANEL_URL, SUPPORT_MAIL, infoMail, sectionId, supportMail } from '../links';

const title = 'RadioPanel · Il pannello di gestione per le radio';
const description = `RadioPanel è il pannello di gestione per le radio di ${OWNER}: palinsesto, staff, dirette anche in video con la Visual Radio, contenuti e sito della radio in un unico posto. Compatibile con AzuraCast e MB Studio.`;
const ogDescription = 'Palinsesto, staff, dirette anche in video, contenuti e sito della radio in un unico pannello. Compatibile con AzuraCast e MB Studio.';

// Dati strutturati per i motori di ricerca (niente prezzo: il costo della licenza è personalizzato)
const siteUrl = new URL('/', Astro.site ?? Astro.url).href;
const publisher = { '@type': 'Organization', name: OWNER, email: INFO_MAIL, logo: new URL('logo.png', siteUrl).href };
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'WebSite', name: 'RadioPanel', url: siteUrl, inLanguage: 'it', publisher },
		{
			'@type': 'SoftwareApplication',
			name: 'RadioPanel',
			applicationCategory: 'BusinessApplication',
			operatingSystem: 'Windows, macOS, Web',
			url: siteUrl,
			description: ogDescription,
			publisher,
		},
	],
}).replaceAll('<', '\\u003c');

const licenseMail =
	`mailto:${INFO_MAIL}?subject=${encodeURIComponent('Richiesta attivazione licenza RadioPanel')}&body=${encodeURIComponent(
		'Buongiorno,\n\nvorrei richiedere l\'attivazione di una licenza RadioPanel.\n\n' +
			'Nome della radio:\nSito web della radio:\nNumero di radio da gestire:\nNumero indicativo di utenti (staff e collaboratori):\n' +
			'Software usati (AzuraCast, MB Studio, altro):\nFunzioni o personalizzazioni richieste:\n\nReferente e recapito:\n',
	)}`;

const features = [
	{ icon: 'calendar-week', area: 'Palinsesto e dirette', text: 'Palinsesto settimanale con variazioni e sostituzioni, scaletta della diretta, turni dello staff e notifiche a chi va in onda.' },
	{ icon: 'broadcast', area: 'In onda e ascolti', text: 'Brano in onda, stato dello streaming, chi è in diretta, ultimi brani trasmessi, ascoltatori e riascolto delle dirette.' },
	{ icon: 'camera-video', area: 'Visual Radio e dirette video', text: 'Schermata in diretta per OBS, vMix o un televisore e dirette video dall\'app desktop, con fino a 3 ospiti anche esterni alla radio.' },
	{ icon: 'people', area: 'Staff e collaboratori', text: 'Utenti, ruoli e permessi, account di gruppo, presenze, giustifiche, report delle ore e ricompense.' },
	{ icon: 'collection', area: 'Contenuti della radio', text: 'Programmi, news, spot con il piano di rotazione e i file dei clienti, scadenze e regolamento interno, in un unico posto per tutta la redazione.' },
	{ icon: 'music-note-list', area: 'Richieste musicali', text: 'Richieste degli ascoltatori dal modulo pubblico, da WhatsApp, da SMS e dalla chat di Kick, con l\'orario di messa in onda segnato da solo.' },
	{ icon: 'pen', area: 'Documenti e firme', text: 'Documenti da firmare e da prendere in visione, con il modulo firme della radio aggiunto e compilato da solo, moduli e candidature con raccolta delle risposte.' },
	{ icon: 'display', area: 'Pagine pubbliche e studio', text: 'Palinsesto pubblico, orologio dello studio con la spia ON AIR, postazione di regia e pagine per gli ascoltatori.' },
	{ icon: 'globe2', area: 'Sito della radio', text: 'I dati del pannello (palinsesto, programmi, news) sul sito della radio tramite API, e statistiche delle visite con il consenso dei visitatori e report da stampare.' },
	{ icon: 'chat-dots', area: 'Comunicazioni', text: 'Notifiche nel pannello e sul browser ed email allo staff; chat WhatsApp della radio lette e risposte dal pannello.' },
	{ icon: 'envelope', area: 'Email della radio', text: 'Le caselle della radio nell\'app desktop e dal browser: leggere, scrivere e rispondere con la firma comune e il logo, più caselle per la direzione e avviso delle email nuove.' },
	{ icon: 'shield-lock', area: 'Sicurezza', text: 'Accesso con passkey, verifica in due passaggi, registro delle attività, permessi per ogni pagina e analitiche di come si usa il pannello, mostrate solo come totali.' },
	{ icon: 'diagram-3', area: 'Più radio, un pannello', text: 'Più emittenti nello stesso pannello, ognuna con le sue pagine, il suo staff e i suoi collegamenti, e gruppi radiofonici che gestiscono insieme palinsesti, spot, firme, news, email e knowledge.' },
	{ icon: 'window-desktop', area: 'App e dispositivi', text: 'App desktop per Windows e macOS e pannello installabile dal browser su computer, tablet e smartphone.' },
	{ icon: 'tools', area: 'Utility', text: 'Knowledge base interna, drive condiviso e programmi da scaricare per lo staff.' },
	{ icon: 'life-preserver', area: 'Assistenza', text: 'Ticket di assistenza direttamente dal pannello, documentazione completa e supporto dedicato.' },
];
---

<Base title={title} description={description} ogDescription={ogDescription}>
	<script type="application/ld+json" slot="head" is:inline set:html={jsonLd} />

	<!-- Apertura -->
	<section class="hero">
		<div class="wrap hero-grid">
			<div class="hero-text">
				<p class="eyebrow">Software di gestione per le radio</p>
				<h1>La regia della tua radio, in un unico pannello.</h1>
				<div class="tuning" aria-hidden="true"></div>
				<p class="lead">
					Palinsesto, dirette anche in video, staff, contenuti e sito della radio: RadioPanel mette tutto in un solo posto, per chi
					va in onda e per chi dirige la radio.
				</p>
				<div class="actions">
					<a class="btn btn-primary btn-lg" href={`#${sectionId('licenza')}`}>
						Richiedi una licenza<i class="bi bi-arrow-right" aria-hidden="true"></i>
					</a>
					<a class="btn btn-lg" href={PANEL_URL}>
						<i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Accedi al pannello
					</a>
				</div>
				<p class="hero-note">
					<i class="bi bi-patch-check" aria-hidden="true"></i>
					Un software di <strong>{OWNER}</strong> · non sostituisce la messa in onda: si collega ad <strong>AzuraCast</strong> e{' '}
					<strong>MB Studio</strong>
				</p>
			</div>

			<!-- Anteprima disegnata del pannello (dati di esempio) -->
			<div class="preview" aria-hidden="true">
				<div class="preview-bar">
					<span class="dot"></span><span class="dot"></span><span class="dot"></span>
					<span class="preview-url">{PANEL_HOST}</span>
				</div>
				<div class="preview-body">
					<div class="onair">
						<span class="onair-led"></span>
						<div>
							<p class="mono-label">In diretta</p>
							<p class="onair-show">Buongiorno Radio</p>
							<p class="onair-song"><i class="bi bi-music-note-beamed"></i> Radio Esempio · brano in onda</p>
						</div>
						<span class="pill pill-live">ON AIR</span>
					</div>
					<div class="progress"><span></span></div>
					<p class="mono-label">Palinsesto di oggi</p>
					<ul class="schedule">
						<li><span class="time">07:00</span><span>Buongiorno Radio</span><span class="pill pill-now">ora</span></li>
						<li><span class="time">10:00</span><span>Mattina in musica</span></li>
						<li><span class="time">13:00</span><span>News e approfondimenti</span></li>
						<li><span class="time">15:00</span><span>Pomeriggio insieme</span></li>
					</ul>
					<div class="stats">
						<div><p class="mono-label">In ascolto</p><p class="stat">128</p></div>
						<div><p class="mono-label">Staff in turno</p><p class="stat">6</p></div>
						<div><p class="mono-label">Richieste</p><p class="stat">14</p></div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Compatibilità in breve -->
	<section class="strip" aria-label="Compatibilità">
		<div class="wrap strip-inner">
			<p class="mono-label">Funziona con</p>
			<div class="strip-items">
				<span><i class="bi bi-soundwave" aria-hidden="true"></i>AzuraCast</span>
				<span><i class="bi bi-sliders2-vertical" aria-hidden="true"></i>MB Studio</span>
				<span><i class="bi bi-windows" aria-hidden="true"></i>Windows</span>
				<span><i class="bi bi-apple" aria-hidden="true"></i>macOS</span>
				<span><i class="bi bi-phone" aria-hidden="true"></i>Smartphone e tablet</span>
			</div>
		</div>
	</section>

	<!-- Funzioni -->
	<section class="section" id={sectionId('funzioni')}>
		<div class="wrap">
			<header class="section-head">
				<p class="eyebrow">Cosa offre</p>
				<h2>Tutto quello che serve a una radio</h2>
				<p>Ogni area del lavoro di una radio ha la sua sezione nel pannello. Ognuno vede solo quello che gli serve, in base al ruolo.</p>
			</header>
			<div class="table-wrap">
				{/* I ruoli sono scritti a mano perché su smartphone la tabella diventa a schede (display: block) e li perderebbe */}
				<table class="features" role="table">
					<thead role="rowgroup">
						<tr role="row">
							<th scope="col" role="columnheader">Area</th>
							<th scope="col" role="columnheader">Cosa offre</th>
						</tr>
					</thead>
					<tbody role="rowgroup">
						{
							features.map((f) => (
								<tr role="row">
									<th scope="row" role="rowheader">
										<span class="feat-icon"><i class={`bi bi-${f.icon}`} aria-hidden="true" /></span>
										{f.area}
									</th>
									<td role="cell">{f.text}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="table-note">
				Tutte le funzioni sono incluse nella licenza. Vuoi vedere nel dettaglio come funziona ogni pagina?{' '}
				<a href={DOCS_URL}>Leggi la documentazione <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
			</p>
		</div>
	</section>

	<!-- Visual Radio e Diretta Video -->
	<section class="section section-alt" id={sectionId('visual-radio')}>
		<div class="wrap">
			<header class="section-head">
				<p class="eyebrow">Visual Radio</p>
				<h2>La tua radio, anche in video</h2>
				<p>
					Una schermata in diretta da mandare in onda con OBS o vMix, o da lasciare su un televisore. E quando chi conduce accende la
					webcam, la radio va in video con i suoi ospiti, senza una regia video dedicata.
				</p>
			</header>
			<div class="cards cards-3">
				<article class="card">
					<CardHead icon="display" title="Schermata in diretta" label="Sempre accesa, in Full HD" />
					<ul class="checks">
						<li>Programma in onda con la spia ON AIR, palinsesto di oggi e brano con la copertina</li>
						<li>Avvisi, promemoria dei podcast e messaggi degli ascoltatori a rotazione</li>
						<li>Si aggiorna da sola, anche quando si aggiorna il pannello</li>
						<li>Sorgente browser per OBS e vMix, o a tutto schermo su un televisore</li>
					</ul>
				</article>
				<article class="card">
					<CardHead icon="camera-video" title="Diretta Video" label="Dall'app desktop" />
					<ul class="checks">
						<li>Webcam e audio del mixer, in stereo e senza filtri sulla voce</li>
						<li>La schermata passa al video con un'animazione e manda in onda l'audio della diretta</li>
						<li>Solo durante il proprio programma, come dice il palinsesto</li>
						<li>Codice QR per scrivere alla radio su WhatsApp e social di chi conduce</li>
					</ul>
				</article>
				<article class="card">
					<CardHead icon="people" title="Ospiti in video" label="Conduttore più 3 ospiti" />
					<ul class="checks">
						<li>Fino a 3 ospiti: chi è della radio entra dall'app, chi è esterno con un link</li>
						<li>Si vedono tra loro come in una videochiamata</li>
						<li>Il conduttore decide per ognuno se il suo audio va in onda</li>
						<li>Video leggero anche per i computer meno recenti, con un ritardo di una frazione di secondo</li>
					</ul>
				</article>
			</div>
			<p class="table-note">
				Come si usa, passo per passo: <a href={DOCS.direttaVideo}>Diretta Video <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
				{' '}· <a href={DOCS.visualRadio}>Schermata della Visual Radio <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
			</p>
		</div>
	</section>

	<!-- Compatibilità nel dettaglio -->
	<section class="section" id={sectionId('compatibilita')}>
		<div class="wrap">
			<header class="section-head">
				<p class="eyebrow">Integrazioni</p>
				<h2>Lavora con gli strumenti che la radio usa già</h2>
				<p>RadioPanel si collega allo streaming e al programma di messa in onda della radio: niente doppio lavoro, i dati arrivano da soli.</p>
			</header>
			<div class="cards cards-2">
				<article class="card">
					<CardHead icon="soundwave" title="AzuraCast" label="Streaming e AutoDJ" />
					<ul class="checks">
						<li>Brano in onda, stato dello streaming e chi è in diretta</li>
						<li>Ascoltatori e analitiche degli ascolti</li>
						<li>Registrazioni delle dirette da riascoltare</li>
						<li>Account DJ collegati al palinsesto: gli orari si aggiornano da soli</li>
						<li>Diretta consentita solo negli orari del palinsesto</li>
					</ul>
				</article>
				<article class="card">
					<CardHead icon="sliders2-vertical" title="MB Studio" label="Programma di messa in onda" />
					<ul class="checks">
						<li>Brano in onda e ultimi brani presi direttamente dalla regia</li>
						<li>Riascolto delle dirette</li>
						<li>Orologio dello studio e Visual Radio con il brano in onda</li>
						<li>Funziona insieme ad AzuraCast per stato della radio e ascoltatori</li>
					</ul>
				</article>
			</div>
		</div>
	</section>

	<!-- Su misura -->
	<section class="section section-alt" id={sectionId('su-misura')}>
		<div class="wrap">
			<header class="section-head">
				<p class="eyebrow">Su misura</p>
				<h2>Si adatta alla tua radio</h2>
				<p>Ogni radio lavora a modo suo: pagine, ruoli e funzioni si scelgono sulla tua organizzazione, non il contrario.</p>
			</header>
			<div class="cards cards-3">
				<article class="card">
					<span class="card-icon"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i></span>
					<h3>Pagine e sezioni</h3>
					<p>Scegli quali pagine attivare per ogni radio, come ordinarle nel menu e chi le vede.</p>
				</article>
				<article class="card">
					<span class="card-icon"><i class="bi bi-person-gear" aria-hidden="true"></i></span>
					<h3>Ruoli e permessi</h3>
					<p>Ruoli costruiti sulla struttura della radio: dai collaboratori allo Station Manager.</p>
				</article>
				<article class="card">
					<span class="card-icon"><i class="bi bi-puzzle" aria-hidden="true"></i></span>
					<h3>Funzioni dedicate</h3>
					<p>Nuove funzioni, integrazioni e adattamenti sviluppati su richiesta per la tua radio.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- App desktop -->
	<section class="section" id={sectionId('app')}>
		<div class="wrap app-grid">
			<div>
				<p class="eyebrow">App desktop</p>
				<h2>RadioPanel sul tuo computer</h2>
				<div class="tuning" aria-hidden="true"></div>
				<p class="app-lead">
					L'app per Windows e macOS apre il pannello nella sua finestra, con notifiche, avvisi sonori, accesso che resta attivo, la
					postazione dello studio e l'email della radio. Per entrare serve un account RadioPanel.
				</p>
				<p class="app-help">
					<i class="bi bi-book" aria-hidden="true"></i>
					Installazione e primo avvio passo per passo: <a href={DOCS.installazione}>guida all'installazione</a>
				</p>
				<p class="app-help">
					<i class="bi bi-envelope" aria-hidden="true"></i>
					Ti serve solo l'email della radio? <a href="/newclient-email/">Si apre anche dal browser</a>
				</p>
			</div>
			<div class="downloads">
				<DownloadButton os="windows" />
				<DownloadButton os="mac" />
				<p class="download-note">
					<i class="bi bi-info-circle" aria-hidden="true"></i>
					Sul Mac, al primo avvio, l'app va autorizzata una volta da Impostazioni di Sistema → Privacy e sicurezza.{' '}
					<a href={DOCS.primoAvvioMac}>Come fare</a>
				</p>
			</div>
		</div>
	</section>

	<!-- Licenza -->
	<section class="section section-alt" id={sectionId('licenza')}>
		<div class="wrap">
			<div class="license">
				<div class="license-text">
					<p class="eyebrow">Licenza</p>
					<h2>Attiva RadioPanel per la tua radio</h2>
					<div class="tuning" aria-hidden="true"></div>
					<p>
						RadioPanel è un software di <strong>{OWNER}</strong> e si usa con una licenza, che si attiva su richiesta e ha un{' '}
						<strong>costo personalizzato</strong> in base alla radio: numero di emittenti e di utenti, funzioni e personalizzazioni.
					</p>
					<ol class="steps">
						<li>
							<span class="step-n">01</span>
							<div><strong>Richiesta di attivazione</strong><p>Scrivici con i dati della radio e cosa ti serve.</p></div>
						</li>
						<li>
							<span class="step-n">02</span>
							<div><strong>Proposta su misura</strong><p>Ricevi una proposta con il costo personalizzato per la tua radio.</p></div>
						</li>
						<li>
							<span class="step-n">03</span>
							<div><strong>Attivazione</strong><p>Attiviamo la licenza e il tuo staff accede al pannello.</p></div>
						</li>
					</ol>
				</div>
				<aside class="license-card">
					<p class="mono-label">Licenza RadioPanel</p>
					<p class="price">Costo personalizzato</p>
					<p class="price-sub">Calcolato sulle esigenze della tua radio</p>
					<ul class="checks">
						<li>Tutte le funzioni del pannello</li>
						<li>Collegamento con AzuraCast e MB Studio</li>
						<li>App desktop per Windows e macOS</li>
						<li>Personalizzazioni su richiesta</li>
						<li>Aggiornamenti e supporto dedicato</li>
					</ul>
					<a class="btn btn-primary btn-lg btn-block" href={licenseMail}>
						<i class="bi bi-envelope" aria-hidden="true"></i>Richiedi l'attivazione
					</a>
					<p class="license-hint">
						Si apre un'email già pronta da completare. Non si apre? Scrivi a <strong>{INFO_MAIL}</strong> con il nome della radio e
						il numero di emittenti e di utenti.
					</p>
				</aside>
			</div>
		</div>
	</section>

	<!-- Contatti -->
	<section class="section" id={sectionId('contatti')}>
		<div class="wrap">
			<header class="section-head">
				<p class="eyebrow">Contatti</p>
				<h2>Parla con noi</h2>
				<p>Titolare e licenziante del software è <strong>{OWNER}</strong>. Scrivici per informazioni o per assistenza.</p>
			</header>
			<div class="cards cards-3">
				<a class="card card-link" href={infoMail}>
					<span class="card-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span>
					<h3>Informazioni e licenze</h3>
					<p>Richieste di attivazione, preventivi e personalizzazioni.</p>
					<span class="card-mail">{INFO_MAIL}</span>
				</a>
				<a class="card card-link" href={supportMail}>
					<span class="card-icon"><i class="bi bi-life-preserver" aria-hidden="true"></i></span>
					<h3>Supporto</h3>
					<p>Assistenza tecnica per le radio che usano già RadioPanel.</p>
					<span class="card-mail">{SUPPORT_MAIL}</span>
				</a>
				<a class="card card-link" href={DOCS_URL}>
					<span class="card-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
					<h3>Documentazione</h3>
					<p>Come funziona ogni pagina del pannello, passo per passo.</p>
					<span class="card-mail">{DOCS_HOST}</span>
				</a>
			</div>
		</div>
	</section>

	<!-- Chiusura -->
	<section class="cta">
		<div class="wrap cta-inner">
			<div>
				<h2>Vuoi RadioPanel per la tua radio?</h2>
				<p>Richiedi una licenza: ricevi una proposta su misura. Se la tua radio lo usa già, accedi al pannello.</p>
			</div>
			<div class="actions">
				<a class="btn btn-primary btn-lg" href={`#${sectionId('licenza')}`}>
					Richiedi una licenza<i class="bi bi-arrow-right" aria-hidden="true"></i>
				</a>
				<a class="btn btn-lg" href={PANEL_URL}>
					<i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Accedi al pannello
				</a>
			</div>
		</div>
	</section>
</Base>
